# Copie ce fichier en ".env" (non versionne par git) et remplis de vraies valeurs.
# docker-compose charge automatiquement le ".env" present a la racine du projet.

# Mot de passe de la base MySQL/MariaDB (MYSQL_ROOT_PASSWORD et DB_PASSWORD)
DB_PASSWORD=change-moi-un-mot-de-passe-fort

# Cle secrete Django (genere la tienne avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# )
DJANGO_SECRET_KEY=change-moi-une-cle-secrete-django
